# 운영용 환경변수 예시. 이 파일을 .env.prod 로 복사해서 값을 채운다. .env.prod 는 커밋하지 않는다.
# 실행: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# --- 도메인 / HTTPS ---
DOMAIN=srpfreaks.com
# 브라우저가 접속하는 주소(https). 쉼표로 여러 개, * 금지
CORS_ALLOWED_ORIGINS=https://srpfreaks.com

# --- DB (비밀번호는 서로 다른 긴 무작위 문자열로) ---
DB_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me

# --- 인증 ---
# 32바이트 이상 무작위 문자열. 예: openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-bytes-long-secret
# 구글 OAuth 클라이언트 ID (프론트 빌드에도 쓰인다. 바꾸면 --build로 다시 빌드)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# 이 이메일로 처음 로그인하는 계정이 ROOT가 된다
ROOT_EMAIL=

# ------------------------------------------------------------------
# 로컬에서 HTTP로만 먼저 띄워 볼 때는 위 두 줄을 아래처럼 바꾸고 NGINX_CONF를 켠다.
# (운영 서버에서는 이 세 줄을 쓰지 않는다)
# DOMAIN=localhost
# CORS_ALLOWED_ORIGINS=http://localhost
# NGINX_CONF=local.conf.template
