# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋하지 않는다.
DB_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me
JWT_SECRET=change-me-at-least-32-bytes-long-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# 이 이메일로 처음 로그인하는 계정이 ROOT가 된다 (비우면 ROOT 자동 생성 없음)
ROOT_EMAIL=
# 쉼표로 여러 개. * 금지
CORS_ALLOWED_ORIGINS=http://localhost:3000
# 로컬 http 개발에서만 false
COOKIE_SECURE=false

# 가져오기 API가 허용할 Origin(쉼표로 구분). 기본값은 공식 사이트 주소라 보통 설정하지 않는다
# IMPORT_ALLOWED_ORIGINS=https://p.eagate.573.jp
